{
  "manifest_version": 3,
  "name": "Voitekk Mini Browser",
  "version": "0.3.0",
  "description": "Open Farzi, Uniware, and Shiprocket in a Chrome side panel while working in Voitekk.",
  "permissions": ["sidePanel", "storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Open Voitekk Mini Browser" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https: http:;"
  }
}